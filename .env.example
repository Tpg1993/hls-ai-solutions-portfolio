# ==============================================================================
# HLS AI Portfolio - Root Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE SECURE CREDENTIALS. NEVER COMMIT .env!
# ==============================================================================

# LLM Providers (Server-side ONLY. Do not expose in client builds)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai

# Optional Secondary Fallback Provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_ENABLED=true

# Database & Cache
POSTGRES_USER=hls_admin
POSTGRES_PASSWORD=hls_secure_password_placeholder
POSTGRES_DB=hls_portfolio
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hls_admin:hls_secure_password_placeholder@localhost:5432/hls_portfolio

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_random_32_byte_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application Ports & URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
APP_ENV=development
LOG_LEVEL=INFO

# Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
