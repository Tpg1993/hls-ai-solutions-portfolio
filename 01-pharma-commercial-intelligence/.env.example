# ==============================================================================
# Project 01: Pharma Commercial Intelligence & Next-Best-Action Platform
# Environment Template - Copy to .env and configure. NEVER COMMIT .env!
# ==============================================================================

# LLM Providers (Server-side only)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_ENABLED=true

# Database & Cache
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pharma_commercial
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharma_commercial

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET_KEY=change_this_to_a_random_32_byte_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
APP_ENV=development
LOG_LEVEL=INFO

# Synthetic Data Config
SYNTHETIC_HCP_COUNT=10000
RANDOM_SEED=42
